# Public URL used for canonical links, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://equinoxtinting.com

# Quote form delivery (https://formspree.io). Use the ID from your form's
# endpoint, https://formspree.io/f/<FORM_ID>. Without it, the form shows a
# "please call or email" message instead of pretending to submit.
FORMSPREE_FORM_ID=
